<?xml version="1.0" encoding="utf-8"?>
<!--
    The favicon of attractors.steren.fr: the palette of a piece, as bands.

    An adaptive icon is drawn on 108dp but only the middle 72dp is guaranteed to survive
    the launcher's mask, so the 32px design is mapped onto that middle square — 2.25dp to
    a favicon pixel, from 18 to 90 — and the first and last bands run on to the edge, to
    fill whatever a given launcher leaves showing.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Trails, the pale one and the near-white one. -->
    <path
        android:fillColor="#DBCEC1"
        android:pathData="M0,0h108v27h-108z" />
    <path
        android:fillColor="#F7F6F5"
        android:pathData="M0,27h108v9h-108z" />
    <!-- Sky. -->
    <path
        android:fillColor="#96D5EB"
        android:pathData="M0,36h108v18h-108z" />
    <!-- The background a piece is painted on. -->
    <path
        android:fillColor="#57A3BD"
        android:pathData="M0,54h108v27h-108z" />
    <!-- Ground. -->
    <path
        android:fillColor="#252A2B"
        android:pathData="M0,81h108v27h-108z" />
</vector>

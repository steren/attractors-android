<?xml version="1.0" encoding="utf-8"?>
<!--
    No <monochrome>: the icon is a set of colored bands, and there is no reading of it in
    one color that still says anything. Without the layer, a launcher showing themed icons
    falls back to this one rather than to a blank.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="MonochromeLauncherIcon">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
